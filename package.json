{
  "name": "@tlf-studio/brand",
  "private": true,
  "version": "1.0.0",
  "description": "Identité visuelle de TLF Studio : logos, déclinaisons, ident, kits.",
  "type": "module",
  "scripts": {
    "build:branches": "node scripts/build-branches.mjs",
    "analyse:ident": "node scripts/analyse-ident.mjs",
