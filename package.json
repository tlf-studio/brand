    "kit:mod": "node kit-mod/generate.mjs",
    "miniatures": "node miniatures/generate.mjs",
    "build:presse": "node scripts/build-presse.mjs",
    "sync:presse": "node scripts/sync-presse.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
